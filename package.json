{
  "name": "nubs-legon-website",
  "version": "1.0.0",
  "description": "Website of NUBS Legon, the National Union of Baptist Students, University of Ghana. Static site, no build step.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "npx --yes serve public -l 3000",
    "check": "node scripts/check.js",
    "sync": "node scripts/sync-pages.js",
    "format": "npx --yes prettier --write \"public/content/*.js\" \"public/js/*.js\" \"public/css/*.css\" \"scripts/*.js\" \"*.md\" \"docs/*.md\""
  }
}
